#!/usr/bin/env ruby
# frozen_string_literal: true

#
# This file was generated by Bundler.
#
# The application 'i18n-tasks' is installed as part of a gem, and
# this file is here to facilitate running it.
#

ENV["BUNDLE_GEMFILE"] ||= File.expand_path("../Gemfile", __dir__)

require "rubygems"
require "bundler/setup"

# i18n-tasks doesn't boot Rails (which requires "logger" as a side effect) or require it itself,
# so activesupport crashes on a bare Logger constant without this. Must come after bundler/setup,
# not before (see config/boot.rb's history) - a require that early activates Ruby's own bundled
# default logger instead of the Gemfile.lock-pinned version, which Bundler then conflicts with.
require "logger"

load Gem.bin_path("i18n-tasks", "i18n-tasks")
