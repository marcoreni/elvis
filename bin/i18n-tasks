#!/usr/bin/env ruby
# frozen_string_literal: true

#
# This file was generated by Bundler.
#
# The application 'i18n-tasks' is installed as part of a gem, and
# this file is here to facilitate running it.
#

ENV["BUNDLE_GEMFILE"] ||= File.expand_path("../Gemfile", __dir__)

require "rubygems"
require "bundler/setup"

# Ruby 3.3.5+/3.4 demoted `logger` from a default gem to a bundled one, so it's no longer
# implicitly loaded. i18n-tasks doesn't boot Rails (which requires it as a side effect of its own
# boot sequence) and doesn't require it itself, so `activesupport`'s `logger_thread_safe_level.rb`
# crashes on the bare `Logger` constant without this.
require "logger"

load Gem.bin_path("i18n-tasks", "i18n-tasks")
