
<div class="row wrapper border-bottom white-bg page-heading m-b-md">
    <h2><%= t("views.practice.materials.index.title") %></h2>
    <%= link_to t("views.practice.materials.index.create_button"), new_practice_material_path, :class => 'btn btn-primary pull-right' %>
</div>

<p id="notice"><%= notice %></p>

<table class="table table-bordered bg-white">
  <thead>
    <tr>
      <th><%= t("views.practice.materials.index.cols.name") %></th>
      <th><%= t("views.practice.materials.index.cols.rental_price") %></th>
      <th colspan="2"><%= t("common.labels.actions") %></th>
    </tr>
  </thead>

  <tbody>
    <% @materials.each do |material| %>
      <tr>
        <td><%= material.name %></td>
        <td><%= material.prix %> €</td>
        <td><%= link_to t("common.actions.edit"), edit_practice_material_path(material), :class => 'btn btn-primary' %></td>
        <td><%= link_to t("common.actions.delete"), [:practice, material], method: :delete, data: { confirm: t("common.confirm.sure") }, :class => 'btn btn-primary' %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<br>
