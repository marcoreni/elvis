<%= form_with(model: [:practice, band], local: true) do |form| %>
  <% if band.errors.any? %>
    <div id="error_explanation">
      <h2><%= t("views.shared.form_errors.heading", count: band.errors.count) %></h2>

      <ul>
      <% band.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field">
    <%= form.label :name %>
    <%= form.text_field :name %>
  </div>

  <div class="field">
    <%= form.label :band_type_id %>
    <%= form.collection_select :band_type_id, @band_types, :id, :name, prompt: true %>
  </div>

  <div class="field">
    <%= form.label :music_genre_id %>
    <%= form.collection_select :music_genre_id, @music_genres, :id, :name, prompt: true %>
  </div>

  <div class='field'>
    <%= form.label :blacklisted %>
    <%= form.check_box :blacklisted %>
  </div>

  <div class='actions'>
    <%= form.submit %>
  </div>
<% end %>
