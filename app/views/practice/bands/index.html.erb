<div class="row wrapper border-bottom white-bg page-heading m-b-md">
    <h2><%= t("views.practice.bands.index.title") %></h2>
    <%= link_to t("views.practice.bands.index.create_button"), new_practice_band_path, :class => 'btn btn-primary pull-right'  %>
</div>

<p id="notice"><%= notice %></p>

<table class="table table-bordered bg-white">
  <thead>
    <tr>
      <th><%= t("views.practice.bands.index.cols.band") %></th>
      <th><%= t("views.practice.bands.index.cols.type") %></th>
      <th><%= t("views.practice.bands.index.cols.music_genre") %></th>
      <th colspan="3"><%= t("common.labels.actions") %></th>
    </tr>
  </thead>

  <tbody>
    <% @bands.each do |band| %>
      <tr>
        <td><%= band.name %></td>
        <td><%= band.band_type.name %></td>
        <td><%= band.music_genre.name %></td>
        <td><%= link_to t("views.practice.bands.index.view"), [:practice, band], :class => 'btn btn-primary'  %></td>
        <td><%= link_to t("common.actions.edit"), edit_practice_band_path(band), :class => 'btn btn-primary'  %></td>
        <td><%= link_to t("common.actions.delete"), [:practice, band], method: :delete, data: { confirm: t("common.confirm.sure") }, :class => 'btn btn-primary'  %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<br>
