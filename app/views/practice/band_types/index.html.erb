<div class="row wrapper border-bottom white-bg page-heading m-b-md">
    <h2><%= t("views.practice.band_types.index.title") %></h2>
    <%= link_to t("views.practice.band_types.index.create_button"), new_practice_band_type_path, :class => 'btn btn-primary pull-right' %>
</div>

<p id="notice"><%= notice %></p>

<table class="table table-bordered bg-white">
  <thead>
    <tr>
      <th><%= t("views.practice.band_types.index.cols.name") %></th>
      <th colspan="3"><%= t("common.labels.actions") %></th>
    </tr>
  </thead>

  <tbody>
    <% @band_types.each do |band_type| %>
      <tr>
        <td><%= band_type.name %></td>
        <td><%= link_to t("common.actions.edit"), edit_practice_band_type_path(band_type), :class => 'btn btn-primary' %></td>
        <td><%= link_to t("common.actions.delete"), [:practice, band_type], method: :delete, data: { confirm: t("common.confirm.sure") }, :class => 'btn btn-primary' %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<br>
