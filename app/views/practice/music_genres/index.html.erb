<div class="row wrapper border-bottom white-bg page-heading m-b-md">
    <h2><%= t("views.practice.music_genres.index.title") %></h2>
    <%= link_to t("views.practice.music_genres.index.create_button"), new_practice_music_genre_path, :class => 'btn btn-primary pull-right' %>
</div>

<p id="notice"><%= notice %></p>

<table class="table table-bordered bg-white">
    <thead>
        <tr>
            <th><%= t("views.practice.music_genres.index.cols.name") %></th>
            <th colspan="3"><%= t("common.labels.actions") %></th>
        </tr>
    </thead>

    <tbody>
        <% @music_genres.each do |music_genre| %>
        <tr>
            <td><%= music_genre.name %></td>
            <td><%= link_to t("common.actions.edit"), edit_practice_music_genre_path(music_genre), :class => 'btn btn-primary' %></td>
            <td><%= link_to t("common.actions.delete"), practice_music_genre_path(music_genre), method: :delete, data: { confirm: t("common.confirm.sure") }, :class => 'btn btn-primary' %></td>
        </tr>
        <% end %>
    </tbody>
</table>

<br>
