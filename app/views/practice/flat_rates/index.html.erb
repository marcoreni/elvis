<div class="row wrapper border-bottom white-bg page-heading m-b-md">
    <h2><%= t("views.practice.flat_rates.index.title") %></h2>
  <%= link_to t("views.practice.flat_rates.index.create_button"), new_practice_flat_rate_path, :class => 'btn btn-primary pull-right' %>
</div>

<p id="notice"><%= notice %></p>

<table class="table table-bordered bg-white">
  <thead>
    <tr>
      <th><%= t("views.practice.flat_rates.index.cols.name") %></th>
      <th><%= t("views.practice.flat_rates.index.cols.nb_hours") %></th>
      <th><%= t("views.practice.flat_rates.index.cols.solo_duo_rate") %></th>
      <th><%= t("views.practice.flat_rates.index.cols.group_rate") %></th>
      <th colspan="2"><%= t("common.labels.actions") %></th>
    </tr>
  </thead>

  <tbody>
    <% @flat_rates.each do |flat_rate| %>
      <tr>
        <td><%= flat_rate.name %></td>
        <td><%= flat_rate.nb_hour %></td>
        <td><%= flat_rate.solo_duo_rate %> €</td>
        <td><%= flat_rate.group_rate %> €</td>
        <td><%= link_to t("common.actions.edit"), edit_practice_flat_rate_path(flat_rate), :class => 'btn btn-primary' %></td>
        <td><%= link_to t("common.actions.delete"), [:practice, flat_rate], method: :delete, data: { confirm: t("common.confirm.sure") }, :class => 'btn btn-primary' %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<br>
