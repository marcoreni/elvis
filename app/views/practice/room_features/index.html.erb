<div class="row wrapper border-bottom white-bg page-heading m-b-md">
  <h2><%= t("views.practice.room_features.index.title") %></h2>
  <%= link_to t("views.practice.room_features.index.create_button"), new_practice_room_feature_path, :class => 'btn btn-primary pull-right' %>
</div>

<p id="notice"><%= notice %></p>

<table class="table table-bordered bg-white">
  <thead>
  <tr>
    <th><%= t("views.practice.room_features.index.cols.name") %></th>
    <th><%= t("common.labels.active") %></th>
    <th colspan="2"><%= t("common.labels.actions") %></th>
  </tr>
  </thead>

  <tbody>
  <% @room_features.each do |feature| %>
    <tr>
      <td><%= feature.name %></td>
      <td class="<%= feature.active ? "text-success" : "text-danger" %>"><%= feature.active %></td>
      <td><%= link_to t("common.actions.edit"), edit_practice_room_feature_path(feature), :class => 'btn btn-primary' %></td>
      <td><%= link_to t("common.actions.delete"), [:practice, feature], method: :delete, data: { confirm: t("common.confirm.sure") }, :class => 'btn btn-primary' %></td>
    </tr>
  <% end %>
  </tbody>
</table>

<br>
