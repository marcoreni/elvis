<div class="row m-t">
    <div class="col-lg-6 col-sm-12">
        <div class="ibox">
            <div class="ibox-title">
                <div class="flex flex-space-between-justified">
                    <h2>
                        <%= t("views.activity_application_statuses.index.heading") %>
                    </h2>
                    <div>
                        <%= link_to new_activity_application_status_path, class: "btn btn-primary" do %>
                            <i class="fas fa-plus"></i>
                            <%= t("views.activity_application_statuses.index.new_button") %>
                        <% end %>
                    </div>
                </div>
            </div>
            <div class="ibox-content no-padding">
                <table class="table table-striped" style="margin-bottom: 0">
                    <thead>
                        <th>#</th>
                        <th><%= t("views.activity_application_statuses.index.cols.label") %></th>
                        <th><%= t("views.activity_application_statuses.index.cols.stopping") %></th>
                        <th><%= t("common.labels.active") %></th>
                        <th><%= t("common.labels.actions") %></th>
                    </thead>
                    <tbody>
                        <%= render partial: "activity_application_status_for_index", collection: @activity_application_statuses, as: :status %>
                    </tbody>
                </table>
            </div>
            <div class="ibox-footer">
                <% if @error %>
                    <div class="alert alert-danger">
                        <h3><%= t("views.activity_application_statuses.index.error_title") %></h3>
                        <%= @error %>
                    </div>
                <% end %>
                <% if @message %>
                    <div class="alert alert-info">
                        <h3><%= t("views.activity_application_statuses.index.message_title") %></h3>
                        <%= @message %>
                    </div>
                <% end %>
            </div>
        </div>
    </div>
</div>