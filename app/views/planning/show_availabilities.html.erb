<div class="row wrapper border-bottom white-bg page-heading">
    <h1><%= t("views.planning.show_availabilities.heading") %></h1>
</div>

<div class="row p-sm">
    <div class="col-lg-6">
        <% unless @next_season.nil? %>
            <div class="jumbotron bg-white">
                <h2><%= t("views.planning.show_availabilities.next_season_title") %></h2>
                <p><%= t("views.planning.show_availabilities.next_season_text", season: @next_season.label) %></p>
                <p>
                    <%= link_to t("views.planning.actions.edit"), availabilities_planning_path(@planning["id"]), class: "btn btn-primary" %>
                </p>
            </div>
        <% end %>
    </div>

    <div class="col-lg-6">
        <div class="jumbotron bg-white">
            <h2><%= t("views.planning.show_availabilities.eval_title") %></h2>
            <p><%= t("views.planning.show_availabilities.eval_text", season: @eval_season.label) %></p>
            <div>
                <%= react_component("availability/WeekSelector", {
                    planningId: @planning[:id],
                    buttonLabel: t("views.planning.actions.edit")
                }) %>
            </div>
        </div>
    </div>
</div>
