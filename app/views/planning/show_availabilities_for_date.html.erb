<div class="row wrapper border-bottom white-bg page-heading sticked">
    <h2>
        <%= t("views.planning.show_availabilities_for_date.heading") %>
        <% if @for_season %>
            <%= @next_season.label %>
        <% else %>
            <%= t("views.planning.show_availabilities_for_date.eval_range", from: @day.strftime("%d/%m/%Y"), to: @day_end.strftime("%d/%m/%Y")) %>
        <% end %>
    </h2>
</div>

<% if @for_season and !@planning[:is_locked] and current_user.teacher? %>
    <div class="clearfix p-xs flex flex-wrap">
        <div class="m-b-sm">
            <%= react_component("common/ConfirmLink", { 
                link: @copy_link,
                icon: "fa-copy",
                label: t("views.planning.show_availabilities_for_date.copy_link_label"),
                message: t("views.planning.show_availabilities_for_date.copy_link_message")
            }) %>
        </div>

        <div class="m-b-xs">
            <%= react_component("common/ConfirmLink", { 
                link: @lock_link,
                icon: "fa-lock",
                label: t("views.planning.actions.lock_the_planning"),
                message: t("views.planning.show_availabilities_for_date.lock_link_message")
            }) %>
        </div>
    </div>
<% end %>

<%= react_component("availability/AvailabilityManager", {
    isTeacher: current_user.teacher?,
    day: @day,
    user: @planning[:user],
    kinds: @for_season ? ["c", "o"] : ["e"],
    forSeason: @for_season,
    planningId: @planning[:id],
    intervals: @time_intervals,
    locked: @locked
}) %>
