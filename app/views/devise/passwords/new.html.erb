<div class="middle-box loginscreen">
  <div>
    <div>
      <img src="<%= @school_informations&.logo&.attached? ? url_for(@school_informations.logo) : (asset_pack_path "static/images/logo_elvis_a.png") %>" width="150" height="150" class="picto-loginscreen"/>
    </div>


    <div class="ibox">
      <div class="ibox-title">
        <h5><%= t("devise.passwords.new.forgot_your_password") %></h5>
      </div>

      <div class="ibox-title">
        <label><%= t("views.devise.passwords.new.subtitle") %></label>
      </div>

      <div class="ibox-content">
        <%= form_for(resource, as: resource_name, url: password_path(resource_name), class: "m-t", html: { method: :post }) do |f| %>
          <%= devise_error_messages! %>
          <div class="form-group">
            <%= f.label t("views.devise.passwords.new.login_label") %><br />
            <%= f.text_field :login, autofocus: false, autocomplete: "email", class: "form-control" %>
          </div>

          <%= f.submit t("views.devise.passwords.new.submit"), class: "btn btn-primary block full-width m-b" %>

        <% end %>
      </div>
    </div>
    <div class="ibox-content">
      <%= render "devise/shared/links" %>
    </div>
  </div>
</div>
