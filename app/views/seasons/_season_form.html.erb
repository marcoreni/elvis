<%
  # Erreurs de validation de la saison (renseignées lors d'un create/update en échec).
  season_errors = @season&.errors
  has_errors = season_errors.present? && season_errors.any?
%>

<% if has_errors %>
  <div class="m-t h-auto bg-danger rounded p-sm text-white m-b-sm">
    <strong><%= t("views.seasons.form.save_error_title") %></strong><br />
    <%= t("views.seasons.form.save_error_body") %>
  </div>
<% end %>

<%= form_with scope: :season, model: @season, local: true, multipart: false do |f| %>
  <div class="form-group">
    <%= f.label :label, for: "label" %><br />
    <%= f.text_field :label, autofocus: false, id: "label", class: "form-control" %>
  </div>

  <div class="form-group">
    <%= f.label :nb_lessons, for: "nb_lessons" %><br />
    <%= f.number_field :nb_lessons, autofocus: false, id: "nb_lessons", class: "form-control" %>
  </div>

  <%= render "seasons/date_field", f: f, attr: :start, required: false %>
  <%= render "seasons/date_field", f: f, attr: :end, required: false %>

  <fieldset><legend><%= t("views.seasons.form.for_the_season") %></legend>
    <div style="margin-left: 1em">
      <%= render "seasons/date_field", f: f, attr: :opening_date_for_applications, required: true %>
      <%= render "seasons/date_field", f: f, attr: :opening_date_for_new_applications, required: true %>
      <%= render "seasons/date_field", f: f, attr: :closing_date_for_applications, required: true %>
      <%= render "seasons/date_field", f: f, attr: :date_for_teacher_planning_validation, required: false %>
    </div>
  </fieldset>

  <div class="form-group">
    <div class="checkbox checkbox-primary">
      <%= f.check_box :is_current, autocomplete: "off", id: "is_current", disabled: true %>
      <%= f.label :is_current, for: "is_current", class: "control-label" %>
    </div>
  </div>

  <div class="form-group">
    <div class="select">
      <%= f.label :next_season_id, for: "next_season_id", class: "control-label" %>
      <%
        # on va constituer la liste des saisons qui peuvent être "saison suivante", en incluant la saison "aucune"
        seasons = []
        # on ajoute, en 1ère position, un élément "aucune saison", avec next_season_id=0
        seasons.unshift (Season.new(id: 0, label: t("views.seasons.form.no_next_season")))
        seasons << @season.next_season if @season.next_season_id
        seasons.concat Season.get_next_season_candidates(exclude_id: @season.id).to_a
      %>
      <%= f.collection_select(:next_season_id, seasons, :id, :label, {:selected => @season.next_season_id }, { class: 'form-control' }) %>
    </div>
  </div>

  <!--
  <div class="form-group">
    <div class="checkbox checkbox-primary">
      <%= f.check_box :is_off, autocomplete: "off", id: "is_off", disabled: @season.is_current%>
      <%= f.label "Archivée", for: "is_off", class: "control-label" %>
    </div>
  </div>
  -->
  <div class="form-group">
    <%= f.submit t("common.actions.save"), class: "btn btn-primary block full-width m-b" %>
  </div>
<% end %>
