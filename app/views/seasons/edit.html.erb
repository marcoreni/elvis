
<div class="row wrapper border-bottom white-bg page-heading">
    <h2><%= t("views.seasons.edit.heading", label: @season.label) %></h2>
</div>

<div class="row">
  <div class="col-sm-12">

    <br />

    <div class="row">
      <div class="col col-lg-4">
        <%= render "seasons/season_form" %>

        <div class="form-group">
          <div class="m-t h-auto bg-green rounded p-sm text-white">
            <%= t("views.seasons.edit.warning") %><br/>
            <%= t("views.seasons.edit.autosave_notice") %>
          </div>
        </div>
      </div>

      <div class="col col-lg-8">
        <div class="form-group">
          <%= react_component("seasons/Holidays", {datas: @holidays, sid: @season.id}) %>
        </div>
      </div>
    </div>
  </div>

</div>
