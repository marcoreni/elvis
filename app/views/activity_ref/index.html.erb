<div class="row wrapper border-bottom white-bg page-heading">
  <h2><%= t("views.activity_ref.index.heading") %>
    <%= link_to new_activity_ref_path do %>
      <button class="btn btn-primary btn-sm pull-right m-sm"><i class="fas fa-plus"></i> <%= t("views.activity_ref.index.add") %></button>
    <% end %>
    <%= link_to activity_ref_index_path(format: :csv) do %>
      <button class="btn btn-primary btn-sm pull-right m-sm"><i class="fas fa-download"></i> <%= t("views.activity_ref.index.export") %></button>
    <% end %>
  </h2>
</div>

<br/>

<% @activities.each do |kind, acts| %>
  <h3><%= kind.name %></h3>

  <div class="row">
    <% acts.each do |a| %>
      <div class="col-xl-4 col-md-6 col-xs-12">
        <div class="contact-box d-flex vertical-align align-items-center align-content-center" style="height: 200px;">
          <div class="col-sm-4">
            <% if a.picture.attached? %>
              <%= image_tag url_for(a.picture), class: "m-t-xs img-responsive" %>
            <% end %>
          </div>
          <div class="col-sm-8">
            <h4><strong><%= a.label %></strong></h4>
            <p><%= t("views.activity_ref.index.type", kind: kind.name) %></p>
            <p><%= t("views.activity_ref.index.places", limit: a.occupation_limit, hard_limit: a.occupation_hard_limit) %></p>
            <% unless a.duration.nil? %>
              <% hours = a.duration / 60 %>
              <% minutes = a.duration % 60 %>
              <% if hours > 0 %>
                <p><%= t("views.activity_ref.index.duration_hours", hours: hours, minutes: minutes.to_s.rjust(2, '0')) %></p>
              <% else %>
                <p><%= t("views.activity_ref.index.duration_minutes", minutes: minutes) %></p>
              <% end %>
            <% end %>

            <div class="d-flex">
              <%= link_to edit_activity_ref_path(a), class: "mr-2" do %>
                <button class="btn btn-sm btn-primary"><%= t("common.actions.edit") %></button>
              <% end %>
              <%#= link_to a, method: :delete, data: { confirm: "Êtes vous sûr ?" } do %>
              <!--              <button class="btn btn-sm btn-warning">Supprimer</button>-->
              <%# end %>

              <%= react_component("RemoveComponent", {
                classname: "activity_ref",
                id: a.id,
                validationText: t("common.confirm.sure"),
                btnProps: {
                  className: "btn btn-sm btn-warning"
                },
                children: t("common.actions.delete")
              }) %>
            </div>
          </div>

          <div class="clearfix"></div>
        </div>
      </div>
    <% end %>
  </div>
<% end %>

<% unless flash[:destroy_error].nil? %>
  <%= react_component("utils/SwalBackEndModal", { swal_props: { title: t("views.activity_ref.index.destroy_error_title"), type: 'error', text: t("views.activity_ref.index.destroy_error") } }) %>
<% end %>