
<div class="row wrapper border-bottom white-bg page-heading m-b-md">
  <h2><%= t("views.locations.index.title") %></h2>
  <%= link_to t("views.locations.index.create_button"), new_location_path, :class => 'btn btn-primary pull-right' %>
</div>

<p id="notice"><%= notice %></p>

<table class="table table-bordered bg-white">
  <thead>
  <tr>
    <th><%= t("views.locations.index.cols.name") %></th>
    <th colspan="2"><%= t("common.labels.actions") %></th>
  </tr>
  </thead>

  <tbody>
  <% @locations.each do |location| %>
    <tr>
      <td><%= location.label %></td>
      <td><%= link_to t("common.actions.edit"), edit_location_path(location), :class => 'btn btn-primary' %></td>
      <td><%= link_to t("common.actions.delete"), location, method: :delete, data: { confirm: t("common.confirm.sure") }, :class => 'btn btn-danger' %></td>
    </tr>
  <% end %>
  </tbody>
</table>

<% if flash[:error] %>
  <div class="ibox-footer">
      <div class="alert alert-danger">
        <ul>
          <% flash[:error].each do |message| %>
            <li>
              <h3><%= t("views.locations.index.error_title") %></h3>
              <%= message %>
            </li>
            <% end %>
        </ul>
      </div>
  </div>
<% end %>
