<%= form_with(model: location, local: true) do |form| %>
  <% if flash[:error]&.any? %>
    <div id="error_explanation">
      <h2><%= t("views.shared.form_errors.heading", count: flash[:error].count) %></h2>

      <ul>
        <% flash[:error].each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>
  <div class="row">
    <div class="field form-group col-sm-12">
      <%= form.label :label %>
      <%= form.text_field :label, :class => 'form-control', :required => true %>
    </div>
  </div>

  <div class="actions">
    <%= link_to t("common.actions.back"), parameters_rooms_parameters_path, :class => 'btn btn-primary' %>
    <%= form.submit t("common.actions.save"), :class => 'btn btn-primary' %>
  </div>
<% end %>
