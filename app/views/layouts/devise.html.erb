<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
    <head>
        <title>Elvis</title>
        <%= csrf_meta_tags %>
        <meta name="viewport" content="width=device-width, user-scalable=no">

        <%= stylesheet_pack_tag 'application' %>
    </head>

    <body class="gray-bg">
        <div id="wrapper">
          <div id="page-wrapper" style="margin: 0!important;">
            <div class="row">
              <div class="col-sm-12 text-right" style="z-index: 1;">
                <%= render "partials/language_switcher" %>
              </div>
            </div>
            <div class="row">
              <div class="col-sm-12" style="z-index: 1;">
                <%= yield %>
              </div>
            </div>

            <div class="row">
              <div class="app-footer m-n" style="z-index: 0;">
                <div class="link-footer">
                  <%= link_to :cgu do %>
                    Politique de confidentialité (CGU)
                  <% end%>
                </div>
              </div>
            </div>
          </div>
        </div>

        <%= javascript_pack_tag 'app' %>

      <script type="text/javascript">
          // Plain DOM only -- must not depend on the deferred `app` pack (jQuery lives inside it
          // now). If a pack chunk is slow/stale/failed on this page load, `$` would be undefined
          // here; `document.querySelector` never is.
          document.addEventListener("DOMContentLoaded", function () {
              var footer = document.querySelector(".app-footer");
              if (footer && footer.parentElement) {
                  footer.parentElement.style.height = footer.offsetHeight + "px";
              }
          });
      </script>
    </body>
</html>
