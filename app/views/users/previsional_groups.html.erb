<div class="page-heading">
    <h1>
        <strong><%= t("views.users.previsional_groups.heading") %></strong> <%= @teacher.last_name%> <%= @teacher.first_name%>
        <br />
       <small><%= @season["label"] %></small> 
    </h1>
</div>


<div class="flex">
    <p class="alert alert-info">
        <span class="font-bold m-r-sm">
            <i style="font-size: large" class="fas fa-info-circle "></i>
        </span>
        <%= t("views.users.previsional_groups.info_notice") %>
    </p>
</div>

<div class="flex-column">
    <h2><%= t("views.users.previsional_groups.legend_heading") %></h2><br/>
    <div class="flex ibox-content col-lg-4 col-xs-12 m-b">
        <ul class="list-group">
            <button class="list-group-item student-item" type="button">
                <span class="font-bold">
                    <%= t("views.users.previsional_groups.no_group_change") %>
                </span>
            </button>
            <button class="list-group-item change-informed student-item" type="button">
                <span class="font-bold">
                    <%= t("views.users.previsional_groups.group_change_informed") %>
                </span>
            </button>
            <button class="list-group-item change-uninformed student-item" type="button">
                <span class="font-bold">
                    <%= t("views.users.previsional_groups.group_change_uninformed") %>
                </span>
            </button>
        </ul>
        <ul class="list-group">
            <button class="list-group-item" type="button">
                <span class="font-bold">
                    <%= t("views.users.previsional_groups.continues_next_season") %>
                </span>
            </button>
            <button class="list-group-item" type="button">
                <span class="font-bold font-strike">
                    <%= t("views.users.previsional_groups.stops_next_season") %>
                </span>
            </button>
            <button class="list-group-item" type="button">
                <span class="font-bold font-underlined">
                    <%= t("views.users.previsional_groups.uncertain") %>
                </span>
            </button>
        </ul>
    </div>
</div>

<%= react_component("PrevisionalGroups", {
    season: @season,
    questions: @questions,
    changes: @changes,
    pursue_answers: @pursue_answers,
    evaluation_level_refs: @evaluation_level_refs,
    activities_students: @activities_students,
    activities: @activities,
    students: @students,
    current_user: current_user,
}) %>