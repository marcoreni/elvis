<div class="middle-box text-center loginscreen">
    <div>
        <div>
            <img src="<%= @school_informations&.logo&.attached? ? url_for(@school_informations.logo) : (asset_pack_path "static/images/logo_elvis_a.png") %>" width="150" height="150" class="picto-loginscreen" />
        </div>

        <div class="ibox">
            <div class="ibox-title">
              <h5><%= t("views.users.edit_password.heading") %></h5>
            </div>

            <div class="ibox-content">
            <% if !@has_token%>
                <div >
                    <h3> <%= t("views.users.edit_password.already_set_notice") %></h3>
                    <%= link_to t("views.users.edit_password.redirect_link"), '/u/sign_in', class:"btn btn-primary" %>
                </div>
            <% else %>

                <%= form_for(@user, url: {action: "update_password", controller: "users"}) do |f| %>
                  <div class="form-group">
                    <%= f.label t("views.users.edit_password.new_password_label"), style: "text-align: left; display: block;" %>
                    <%= f.password_field :password, autocomplete: "off", class: "form-control" %>
                    <% if @user.errors.messages[:password] %>
                      <% @user.errors[:password].each do |error| %>
                        <li class="errors-list"><%= error%></li>
                      <% end %>
                    <% end %>
                  </div>
                  <div class="form-group">
                    <%= f.label t("views.users.edit_password.confirm_password_label"), style: "text-align: left; display: block;" %>
                    <%= f.password_field :password_confirmation, autocomplete: "off", class: "form-control" %>
                    <% if @user.errors.messages[:password_confirmation] %>
                      <% @user.errors[:password_confirmation].each do |error| %>
                        <li class="errors-list"><%= error%></li>
                      <% end %>
                    <% end %>
                  </div>

                  <%= hidden_field_tag("reset_password_token", @token) %>

                  <%= f.submit t("common.actions.validate"), class: "btn btn-primary block full-width m-b" %>
                <% end %>


            <% end %>
            
            </div>
        </div>
        
    </div>
</div>
