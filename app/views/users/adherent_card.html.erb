<div class="adhesion_card">
    <div class="card-left">

        <% if @user.avatar.attached? %>
            <img src="<%= url_for(@user.avatar) %>" class="card-image" alt="User Avatar">
        <% else %>
            <img src="<%= asset_pack_path 'static/images/default_avatar.png' %>" class="card-image" alt="User Avatar">
        <% end %>


        <%# <img src="https://www.stevensegallery.com/110/110" class="card-qrcode" alt="QR code"> %>
        <div class="code">
            <%= raw @qr.as_html %>
        </div>
    </div>
    <div class="card-right">
        <div class="card-header">
            <div class="card-header-text">
                <h2><%= t("views.users.adherent_card.title") %></h2>
                <p><b><%= @user.full_name %> (#<%= @user.adherent_number %>)</b></p>
                <% unless @user.birthday.nil? %>
                    <p><%= @user.birthday.strftime("%d/%m/%Y") %></p>
                <% end %>
            </div>
            <div class="card-header-logo">
                <%
                    school = School.first
                    logo_url = ""
                    if school
                        logo_url = school.logo.attached? ? url_for(school.logo) : nil
                    end
                %>
                <img src="<%= logo_url %>" class="card-header-logo-image" alt="logo">
            </div>
        </div>
        <% @user.activities.each do |a| %>
            <div class="card-lesson">
                <p><b><%= t("views.users.adherent_card.course",
                            activity: a.activity_ref.label,
                            civility: a.teacher.sex == "m" ? t("views.users.adherent_card.civility_mr") : t("views.users.adherent_card.civility_mrs"),
                            last_name: a.teacher.last_name) %></b></p>
                <p><%= t("views.users.adherent_card.room_at_location",
                          room: a.room.label,
                          location: a.location.label,
                          day: l(a.time_interval.start, format: "%A").capitalize,
                          time: a.time_interval.start.strftime("%H:%M")) %></p>
            </div>
        <% end %>
    </div>
</div>
