<div class="padding-page">

  <h1><%= @user.full_name %></h1>

  <div class="row">
    <%= form_for(@user, url: {action: "save_new_account"}, html: {class: "col-md-4"}) do |f| %>
    <div class="form-group">
      <% if @user.email.nil? %>
        <%= f.label t("views.users.create_account.email_prompt_missing") %><br />
      <% else %>
        <%= f.label t("views.users.create_account.email_prompt_confirm") %><br />
      <% end %>
      <%= f.email_field :email, autocomplete: "off", class: "form-control", placeholder: "example@example.org" %>
    </div>

    <div class="form-group">
      <%= f.label t("views.users.create_account.password_label") %><br />
      <%= f.password_field :password, autocomplete: "off", class: "form-control" %>
    </div>
    <div class="form-group">
      <%= f.label t("views.users.create_account.password_confirmation_label") %><br />
      <%= f.password_field :password_confirmation, autocomplete: "off", class: "form-control" %>
    </div>

    <%= f.submit t("common.actions.validate"), class: "btn btn-primary block full-width m-b" %>
  <% end %>
  </div>
</div>
