<div class="row wrapper border-bottom white-bg page-heading m-b-md">
  <h2><%= t("views.users.new.heading") %></h2>
</div>
<div class="row">
  <div class="col-lg-6 m-l-sm col-sm-11">
    <%= form_with scope: :user, url: users_path, local: true do |f| %>
      <% unless @errors.nil? %>
        <div class="bg-danger m-b-sm img-rounded color-black p-h-xs">
          <ul>
            <% @errors.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>
      <div class="form-group">
        <div><%= f.label :last_name, User.human_attribute_name(:last_name) %><span class="text-danger">*</span> </div>
        <%= f.text_field :last_name, autofocus: true, required: true, autocomplete: "last name", class: "form-control" %>
      </div>

      <div class="form-group">
        <div><%= f.label :first_name, User.human_attribute_name(:first_name) %><span class="text-danger">*</span></div>
        <%= f.text_field :first_name, autofocus: true, required: true, autocomplete: "first name", class: "form-control" %>
      </div>

      <div class="form-group">
        <div><%= f.label :birthday, User.human_attribute_name(:birthday) %><span class="text-danger">*</span></div>
        <%= f.date_field :birthday, required: true, class: "form-control" %>
      </div>

      <div class="form-group">
        <div><%= f.label :email %><span class="text-danger">*</span></div>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-control" %>
      </div>

      <div class="form-group">
        <%= react_component("common/SelectMultiple", {
          isMulti: false,
          title: t("views.users.new.attached_account_label"),
          name: "user[attached_to_id]",
          all_features: @users_to_attach.map { |user| ["#{user.full_name} (#{user.adherent_number})", user.id] }
        }) %>
      </div>

      <div class="form-group">
        <div class="checkbox checkbox-primary">
          <%= f.check_box :is_admin, autocomplete: "off", id: "admin" %>
          <%= f.label :is_admin, User.human_attribute_name(:is_admin), for: "admin", class: "control-label" %>
        </div>
      </div>

      <div class="form-group">
        <div class="checkbox checkbox-primary">
          <%= f.check_box :is_teacher, autocomplete: "off", id: "isTeacher", onChange: "onProfChange()"%>
          <%= f.label :is_teacher, User.human_attribute_name(:is_teacher), for: "isTeacher", class: "control-label" %>
        </div>
      </div>


      <% if @activity_refs.any? %>
        <div class="form-group" style="display:none">
          <%= f.label :activity_refs, t("views.users.new.activities_label") %>
          <div class="checkbox-list" id="activity-checkbox-list">
            <% for activity_ref in @activity_refs %>
              <div>
                <%= check_box_tag "user[activity_refs][]", activity_ref.id, false %>
                <%= activity_ref.label %>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>

      <div class="form-group">
        <div class="checkbox checkbox-primary">
          <%= f.check_box :adherent, { id: "adherent" }, true, false %>
          <%= f.label :adherent, User.human_attribute_name(:adherent), for: "adherent", class: "control-label" %>
        </div>

        <div class="form-group">
          <div class="checkbox checkbox-primary">
            <%= f.check_box :confirm, { id: "confirm" }, true, false %>
            <%= f.label t("views.users.new.confirm_email_label"), for: "confirm", class: "control-label" %>
          </div>
        </div>

        <%= f.submit t("views.users.new.submit"), class: "btn btn-primary block full-width m-b" %>
    <% end %>
    </div>
    <script type="text/javascript">

        function onProfChange()
        {
            const checkProf = document.getElementById("isTeacher")
            const selectAct = document.getElementById("activity-checkbox-list");

            if(checkProf["checked"]){
                selectAct.setAttribute('required', '');
                selectAct.parentNode.style.display="block"

            }else{
                selectAct.removeAttribute('required');
                selectAct.parentNode.style.display="none"
            }
        }
    </script>
</div>
</div>