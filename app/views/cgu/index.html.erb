  <h4><%= t("views.cgu.index.obligations_heading", school_name: @school_name) %></h4>

  <p><%= t("views.cgu.index.obligations_guarantee", school_name: @school_name&.upcase_first) %></p>

  <p><%= t("views.cgu.index.obligations_principles_intro", school_name: @school_name&.upcase_first, school_name_lower: @school_name) %></p>

  <ul>
    <li><%= t("views.cgu.index.principle_1") %></li>
    <li><%= t("views.cgu.index.principle_2") %></li>
    <li><%= t("views.cgu.index.principle_3") %></li>
    <li><%= t("views.cgu.index.principle_4") %></li>
  </ul>

  <p><%= t("views.cgu.index.security_measures", school_name: @school_name&.upcase_first) %></p>

  <p><%= t("views.cgu.index.final_commitment", school_name: @school_name) %></p>

  <br/>

  <h4><%= t("views.cgu.index.rights_heading") %></h4>
  <p><a target="_blank" href="https://www.cnil.fr/fr/les-droits-pour-maitriser-vos-donnees-personnelles" rel="noopener">https://www.cnil.fr/fr/les-droits-pour-maitriser-vos-donnees-personnelles</a></p>

  <p><%= t("views.cgu.index.rights_guarantee", school_name: @school_name&.upcase_first) %></p>

  <p>
    <%= t("views.cgu.index.rights_how_to_question") %> <br/>
    <p><%= t("views.cgu.index.rights_how_to_email") %> <a href="mailto:<%= @admin_email %>"><%= @admin_email %></a></p>
  </p>

  <hr/>

  <h4><%= t("views.cgu.index.registration_heading") %></h4>


    <p><%= t("views.cgu.index.purposes_heading") %></p>
    <ul>
    <li><%= t("views.cgu.index.purpose_1") %></li>
    <li><%= t("views.cgu.index.purpose_2") %></li>
    <li><%= t("views.cgu.index.purpose_3") %></li>
    </ul>


  <p>
    <%= t("views.cgu.index.storage_heading") %></p>
    <ul>

    <li><%= t("views.cgu.index.storage_sixmon") %> <a target="_blank" href="https://www.sixmon.net/" rel="noopener">https://www.sixmon.net/</a>.</li>
    <li><%= t("views.cgu.index.storage_azure_prefix") %> <a href="https://azure.microsoft.com/fr-fr/" target="_blank" rel="noopener">https://azure.microsoft.com/fr-fr/</a> <%= t("views.cgu.index.storage_azure_suffix") %></li>
  </ul>

  <p><%= t("views.cgu.index.access_heading") %></p>
  <ul>
    <li><%= t("views.cgu.index.access_staff", school_name: @school_name) %></li>
    <li><%= t("views.cgu.index.access_teachers") %></li>
  </ul>
