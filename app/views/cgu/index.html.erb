<div class="row wrapper border-bottom white-bg page-heading m-b-md">
  <h2>
    <%= t("views.cgu.index.title") %>
  </h2>
</div>

<div class="ibox-content">

  <p><%= t("views.cgu.index.gdpr_intro", school_name: @school_name) %></p>

  <p><%= t("views.cgu.index.objectives_intro") %></p>

  <ul>
    <li><%= t("views.cgu.index.objective_1") %></li>
    <li><%= t("views.cgu.index.objective_2") %></li>
    <li><%= t("views.cgu.index.objective_3") %></li>
  </ul>

  <p><%= t("views.cgu.index.internal_procedures", school_name: @school_name) %></p>

