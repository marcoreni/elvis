<%
  common_params = {
    client: @client,
    response_type: @response_type,
    redirect_uri: @redirect_uri,
    scopes: @scopes,
    state: params[:state],
    nonce: params[:nonce],
    _request_: @_request_,
    request_uri: @request_uri
  }
%>

<article>
  <h2><%= t("views.oidc/authorizations.new.heading", client: @client.name) %></h2>
  <dl>
    <dt><%= t("views.oidc/authorizations.new.requested_information") %></dt>
    <% @scopes.each do |scope| %>
      <dd><%= scope.name %></dd>
    <% end %>
  </dl>
  <nav>
    <ul>
      <li>
        <%= render 'oidc/authorizations/form', common_params.merge(action: :approve) %>
      </li>
      <li>
        <%= render 'oidc/authorizations/form', common_params.merge(action: :deny) %>
      </li>
    </ul>
  </nav>
</article>