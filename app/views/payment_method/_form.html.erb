<%= form_with(model: pm, local: true) do |form| %>
  <% if pm.errors.any? %>
    <div id="error_explanation">
      <h2><%= t("views.shared.form_errors.heading", count: pm.errors.count) %></h2>

      <ul>
        <% pm.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <% if pm.built_in %>
    <div class="row">
      <div class="col-sm-10 alert alert-info mx-3">
        <i class="fa fa-info-circle"></i> <%= t("views.payment_method.form.built_in_notice") %>
      </div>
    </div>
  <% end %>

  <div class="row">
    <div class="field form-group col-lg-3 col-md-4 col-sm-12">
      <%= form.label :label, t("activerecord.attributes.payment_method.label") %>
      <%= form.text_field :label, :class => 'form-control', :required => true, disabled: pm.built_in %>
    </div>
  </div>

  <div class="row">
    <div class="col-sm-12">
      <% unless pm.built_in%>
        <div class="checkbox checkbox-primary">
          <%= form.check_box :is_special, :class => 'form-control' %>
          <%= form.label :is_special, t("activerecord.attributes.payment_method.is_special") %>
        </div>

        <div class="checkbox checkbox-primary">
          <%= form.check_box :is_credit_note, :class => 'form-control' %>
          <%= form.label :is_credit_note, t("activerecord.attributes.payment_method.is_credit_note") %>
        </div>
      <% end %>

      <div class="checkbox checkbox-primary">
        <%= form.check_box :show_payment_method_to_user, :class => 'form-control' %>
        <%= form.label :show_payment_method_to_user, t("activerecord.attributes.payment_method.show_payment_method_to_user") %>
      </div>
    </div>
  </div>

  <div class="actions">
    <%= link_to t("common.actions.back"), parameters_payment_parameters_path, :class => 'btn btn-primary' %>
    <%= form.submit t("common.actions.save"), :class => 'btn btn-primary' %>
  </div>
<% end %>