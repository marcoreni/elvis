
<div class="row wrapper border-bottom white-bg page-heading m-b-md">
  <h2><%= t("views.payment_method.index.heading") %></h2>
  <%= link_to t("views.payment_method.index.create"), new_payment_method_path, :class => 'btn btn-primary pull-right' %>
</div>

<p id="notice"><%= notice %></p>

<table class="table table-bordered bg-white">
  <thead>
  <tr>
    <th><%= t("activerecord.attributes.payment_method.label") %></th>
    <th><%= t("activerecord.attributes.payment_method.is_special") %></th>
    <th><%= t("activerecord.attributes.payment_method.is_credit_note") %></th>
    <th colspan="2"><%= t("common.labels.actions") %></th>
  </tr>
  </thead>

  <tbody>
  <% @payment_methods.each do |pm| %>
    <tr>
      <td><%= pm.label %></td>
      <td><%= pm.is_special %></td>
      <td><%= pm.is_credit_note %></td>
      <td><%= link_to t("common.actions.edit"), edit_payment_method_path(pm), :class => 'btn btn-primary' %></td>
      <td><%= link_to t("common.actions.delete"), payment_method_path(pm), method: :delete, data: { confirm: t("common.confirm.sure") }, :class => 'btn btn-primary' %></td>
    </tr>
  <% end %>
  </tbody>
</table>

<br>